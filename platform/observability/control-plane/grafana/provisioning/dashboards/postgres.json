{
  "uid": "postgres",
  "title": "PostgreSQL de PRD",
  "tags": [
    "workshop",
    "postgres"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Disponibilidade e conexões",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "PostgreSQL acessível (pg_up)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_up{job=\"workshop/postgres-exporter\"}",
          "legendFormat": "pg_up",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "1: o papel workshop_metrics consulta o banco pela rede workshop-db-metrics. 0: banco fora, rede desconectada (banco recriado) ou senha divergente."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Conexões em % de max_connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pg_stat_database_numbackends{job=\"workshop/postgres-exporter\"}) / max(pg_settings_max_connections{job=\"workshop/postgres-exporter\"}) * 100",
          "legendFormat": "conexões",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "Alerta WorkshopPostgresConnectionsHigh acima de 80% por 10 minutos."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Conexões por banco",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_stat_database_numbackends{job=\"workshop/postgres-exporter\", datname!~\"template.*\"}",
          "legendFormat": "{{datname}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Transações e cache",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transações por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit_total{job=\"workshop/postgres-exporter\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "commit {{datname}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback_total{job=\"workshop/postgres-exporter\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "rollback {{datname}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Acerto do cache de blocos",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_blks_hit_total{job=\"workshop/postgres-exporter\", datname!~\"template.*\"}[$__rate_interval])) / (sum by (datname) (rate(pg_stat_database_blks_hit_total{job=\"workshop/postgres-exporter\", datname!~\"template.*\"}[$__rate_interval])) + sum by (datname) (rate(pg_stat_database_blks_read_total{job=\"workshop/postgres-exporter\", datname!~\"template.*\"}[$__rate_interval])))",
          "legendFormat": "{{datname}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Fração das leituras de bloco atendidas pelo shared_buffers. Queda sustentada indica memória insuficiente para o conjunto de trabalho."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Deadlocks e arquivos temporários",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (increase(pg_stat_database_deadlocks_total{job=\"workshop/postgres-exporter\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "deadlocks {{datname}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (increase(pg_stat_database_temp_files_total{job=\"workshop/postgres-exporter\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "temp files {{datname}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Armazenamento e WAL",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tamanho por banco",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_database_size_bytes{job=\"workshop/postgres-exporter\", datname!~\"template.*\"}",
          "legendFormat": "{{datname}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tamanho do WAL em pg_wal",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_wal_size_bytes{job=\"workshop/postgres-exporter\"}",
          "legendFormat": "pg_wal",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "description": "Crescimento contínuo com falhas de arquivamento indica WAL retido à espera do pgBackRest."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Arquivamento de WAL (pgBackRest)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(pg_stat_archiver_archived_count_total{job=\"workshop/postgres-exporter\"}[$__rate_interval])",
          "legendFormat": "arquivados",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(pg_stat_archiver_failed_count_total{job=\"workshop/postgres-exporter\"}[$__rate_interval])",
          "legendFormat": "falhas",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Falhas do archive_command disparam WorkshopPostgresWalArchiveFailing (critical): o PITR deixa de cobrir as escritas recentes."
    },
    {
      "id": 13,
      "type": "row",
      "title": "Locks",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Locks por modo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (pg_locks_count{job=\"workshop/postgres-exporter\", datname!~\"template.*\"})",
          "legendFormat": "{{mode}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
