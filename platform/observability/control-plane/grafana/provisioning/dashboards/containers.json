{
  "uid": "containers",
  "title": "Containers de PRD",
  "tags": [
    "workshop",
    "containers"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "container",
        "label": "Container",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(container_uptime_seconds{job=\"workshop/docker-stats\"}, container_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(container_uptime_seconds{job=\"workshop/docker-stats\"}, container_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Consumo por container",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU por container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "container_cpu_utilization_ratio{job=\"workshop/docker-stats\", container_name=~\"$container\"}",
          "legendFormat": "{{container_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "Utilização reportada pelo receiver docker_stats (porcentagem do CPU por container; pode passar de 100% em container com mais de um CPU)."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memória em uso por container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "container_memory_usage_total_bytes{job=\"workshop/docker-stats\", container_name=~\"$container\"}",
          "legendFormat": "{{container_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Memória e reinícios",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memória em % do limite",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "container_memory_percent_ratio{job=\"workshop/docker-stats\", container_name=~\"$container\"}",
          "legendFormat": "{{container_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "Uso em relação ao limite de memória reportado pelo Docker para o container."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Reinícios nos últimos 30 minutos",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container_name) (increase(container_restarts_total{job=\"workshop/docker-stats\", container_name=~\"$container\"}[30m]))",
          "legendFormat": "{{container_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Contador do Docker (RestartCount). Reinício pelo restart policy aparece aqui; recriação no deploy zera o contador."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Uptime por container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "container_uptime_seconds{job=\"workshop/docker-stats\", container_name=~\"$container\"}",
          "legendFormat": "{{container_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Queda para zero ou para um valor baixo indica que o container foi recriado."
    },
    {
      "id": 8,
      "type": "row",
      "title": "Rede",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rede recebida por container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container_name) (rate(container_network_io_usage_rx_bytes_total{job=\"workshop/docker-stats\", container_name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{container_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Rede enviada por container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container_name) (rate(container_network_io_usage_tx_bytes_total{job=\"workshop/docker-stats\", container_name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{container_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Cobertura",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Containers reportados ao longo do tempo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (container_name) (container_uptime_seconds{job=\"workshop/docker-stats\", container_name=~\"$container\"}))",
          "legendFormat": "containers",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Queda na contagem sem deploy indica container parado ou removido. Os alertas de containers críticos (API e banco) cobrem esse caso."
    }
  ]
}
