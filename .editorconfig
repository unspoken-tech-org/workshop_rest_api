root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,sh,tf,tfvars}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Keep existing Flyway migration line endings and whitespace intact for checksum compatibility.
[apps/api/src/main/resources/db/migration/**/*.sql]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
